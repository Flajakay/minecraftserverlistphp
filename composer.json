{
    "name": "flajakay/serverlist",
    "description": "A server list application",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "davedevelopment/stiphle": "^0.9.4",
        "paypal/paypal-server-sdk": "^1.1",
      "ext-gd": "*",
      "ext-sockets": "*",
      "ext-pdo": "*",
      "ext-openssl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "config/app.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
