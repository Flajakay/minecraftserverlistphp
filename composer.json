{
    "name": "flajakay/serverlist",
    "description": "A server list application",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sockets": "*",
        "davedevelopment/stiphle": "^0.9.4",
        "paypal/paypal-server-sdk": "^1.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
