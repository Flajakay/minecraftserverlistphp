{
    "name": "flajakay/serverlist",
    "description": "A server list application",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "davedevelopment/stiphle": "^0.9.4",
        "paypal/paypal-checkout-sdk": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "config/app.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
