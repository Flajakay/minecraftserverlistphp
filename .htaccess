RewriteEngine On

# Installation redirect - if install.php exists and we're not accessing it
RewriteCond %{DOCUMENT_ROOT}/install.php -f
RewriteCond %{SCRIPT_FILENAME} !install.php
RewriteRule ^(index\.php|/|)$ install.php [L]

# Handle static assets
RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

RewriteCond %{REQUEST_URI} ^/uploads/
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

# Handle main application
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ index.php [QSA,L]

Options -Indexes

<Files "*.php">
    Order Allow,Deny
    Allow from all
</Files>

<Files "config/*">
    Order Deny,Allow
    Deny from all
</Files>

Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
Header always set X-XSS-Protection "1; mode=block"

# Error pages
ErrorDocument 404 /not-found
ErrorDocument 403 /not-found
ErrorDocument 500 /not-found
